# Copy to .env.prod on EC2 and fill in real values. Do not commit .env.prod.
# Use your RDS PostgreSQL endpoint, not localhost.
DB_URL=jdbc:postgresql://YOUR-RDS-ENDPOINT:5432/RestaurantDB
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES

FRONTEND_URL=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com
OAUTH2_REDIRECT_URI=https://example.com/login/oauth2/code/google

MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TEST_USERS_ENABLED=false

BACKEND_IMAGE=anadinatu/restaurant-management-backend:latest
FRONTEND_IMAGE=anadinatu/restaurant-ui:latest

# Used only by init-letsencrypt.sh
DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com
CERT_NAME=example.com
CERTBOT_STAGING=0
